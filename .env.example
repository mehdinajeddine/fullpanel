# Docker Compose configuration. Copy to .env; never commit credentials.
PANEL_PORT=3000
ACME_EMAIL=you@example.com
# Only required with compose.public.yaml.
PANEL_DOMAIN=panel.example.com
# Prototype only: real Docker PTY and crash recovery are not yet verified.
HARBORLIGHT_EXPERIMENTAL_TERMINAL=false
# For local development use shell environment:
# HARBORLIGHT_MODE=demo DATA_DIR=.data/demo npm run dev
