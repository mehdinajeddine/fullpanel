{
  "name": "harborlight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An independent, open-source control panel for self-hosted applications.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'npm:dev:server' 'npm:dev:web'",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run licenses:generate && tsc --noEmit && vite build && tsup server/index.ts --format esm --platform node --out-dir dist/server --external fastify --external @fastify/cookie --external @fastify/static --external @fastify/rate-limit --external zod --external yaml",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test server/*.test.ts server/tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:docker": "tsx scripts/smoke-docker.ts",
    "test:proxy": "tsx scripts/smoke-proxy.ts",
    "test:test-domains": "tsx scripts/smoke-test-domains.ts",
    "test:service-metrics": "tsx scripts/smoke-service-metrics.ts",
    "test:package": "tsx scripts/smoke-package.ts",
    "test:credentials": "tsx scripts/smoke-credentials.ts",
    "test:git": "tsx scripts/smoke-git.ts",
    "test:git-ssh": "tsx scripts/smoke-git-ssh.ts",
    "test:github": "tsx scripts/smoke-github.ts",
    "test:releases": "tsx scripts/smoke-releases.ts",
    "test:releases-ui": "tsx scripts/smoke-releases-ui.ts",
    "test:environment": "tsx scripts/smoke-environment.ts",
    "test:engines": "tsx scripts/smoke-new-engines.ts",
    "test:restore": "tsx scripts/smoke-restore.ts",
    "test:restore-ui": "tsx scripts/smoke-restore-ui.ts",
    "test:restore-recovery": "tsx scripts/smoke-restore-recovery.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "11.3.7",
    "@fontsource-variable/inter": "5.3.0",
    "@mongodb-js/saslprep": "1.6.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.6.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "8.22.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.2"
    }
  }
}
